local function triggerDecision(now, onTarget, pressed, pressStart, lastRelease)
        if pressed then
                local held = now - pressStart
                if (not onTarget and held >= TRIGGER_TAP_MIN) or held >= TRIGGER_TAP_MAX then
                        return "release"
                end
                return "hold"
        end
        if not onTarget then return "wait" end
        if now - lastRelease < TRIGGER_GAP then return "wait" end
        return "press"
end

local TriggerBot = { pressed = false, pressStart = 0, lastRelease = 0 }
local function triggerBackendExhausted(contextMsg)
        TriggerBot.pressed = false
        State.TriggerBot = false
        triggerBackendQueue = backendOrder(IS_TOUCH, State.TriggerBackend)
        if updateTriggerFloatVisual then updateTriggerFloatVisual() end
        log("ERROR", "Trigger Bot: " .. contextMsg .. " — ปิด trigger (แตะ TRG จะลองชุด backend ใหม่)")
        if setStickyStatus then setStickyStatus("trigger bot: " .. contextMsg) end
end

local function releaseOrFallback()
        if not fireRelease then return end
        if pcall(fireRelease) then return end
        local brokenName = fireName
        if pickNextBackend("fallback หลัง " .. tostring(brokenName) .. " release error") then
                pcall(fireRelease)
        else
                triggerBackendExhausted("ปล่อยคลิกไม่สำเร็จและไม่เหลือ backend")
        end
end

toggleTriggerBot = function(source)
        State.TriggerBot = not State.TriggerBot
        if updateTriggerFloatVisual then updateTriggerFloatVisual() end
        if State.TriggerBot and firePress == nil then
                log("WARN", "Trigger Bot ON แต่ไม่มี backend ส่งคลิก — ยิงไม่ได้ (ดู WARN ตอนโหลดสคริปต์)")
                if setStickyStatus then setStickyStatus("trigger bot: ไม่มี backend ส่งคลิก") end
        end
        log("INFO", "Trigger Bot " .. (State.TriggerBot and "ON" or "OFF") .. " (" .. source .. ")")
end

