-- 5. VISIBILITY SERVICE (Reuse RaycastParams)
-- ==========================================
local VisibilityService = {}

-- [PERF] ใช้ RaycastParams ตัวเดียวทั้งสคริปต์ + scratch table
-- เดิม: RaycastParams.new() ทุกครั้งที่เช็ค visibility = garbage ทุกเฟรม
local RayParams = RaycastParams.new()
RayParams.FilterType = Enum.RaycastFilterType.Exclude
RayParams.IgnoreWater = true

local ScratchFilter = {}

function VisibilityService:CheckVisibility(targetCharacter, pierceCount, specificPart)
        local camera = getCamera()
        if not (camera and targetCharacter) then return false end

        local targetPart = specificPart
        if not (targetPart and targetPart.Parent) then
                targetPart = targetCharacter:FindFirstChild("Head")
                        or targetCharacter:FindFirstChild("HumanoidRootPart")
        end
        if not targetPart then return false end

        local origin = camera.CFrame.Position
        local targetPos = targetPart.Position
        local direction = targetPos - origin

        -- [BUG 6 FIX] origin ชน target เกือบเป๊ะ = มองเห็นอยู่แล้ว (เดิม .Unit แตก NaN)
        if direction.Magnitude < 0.05 then return true end

        local maxPierces = pierceCount or 1
        local currentOrigin = origin
        local currentDirection = direction

        table.clear(ScratchFilter)
        local n = 0
        local myChar = LocalPlayer and LocalPlayer.Character
        if myChar then
                n += 1
                ScratchFilter[n] = myChar
        end

        for i = 1, maxPierces do
                RayParams.FilterDescendantsInstances = ScratchFilter
                local result = Workspace:Raycast(currentOrigin, currentDirection, RayParams)

                if not result then return true end

                local hitPart = result.Instance
                if hitPart:IsDescendantOf(targetCharacter) then return true end

                if i < maxPierces and (hitPart.Transparency > 0.8 or not hitPart.CanCollide) then
                        n += 1
                        ScratchFilter[n] = hitPart
                        local seg = targetPos - result.Position
                        local segUnit = safeUnit(seg)
                        if not segUnit then return true end
                        currentOrigin = result.Position + segUnit * 0.05
                        currentDirection = seg
                else
                        return false
                end
        end
        return false
end

