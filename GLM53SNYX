-- ==========================================
-- 6. TARGET SERVICE (State Machine)
-- ==========================================
local TargetService = {
        CurrentTarget = nil,
        TargetPart = nil,
        LockedPartName = nil
}

local RANDOM_PARTS = { "Head", "UpperTorso", "LowerTorso", "HumanoidRootPart" }

function TargetService:GetTargetPart(char)
        local root = char:FindFirstChild("HumanoidRootPart")
        if State.TargetPartMode == "Head" then
                return char:FindFirstChild("Head") or root
        end
        if State.TargetPartMode == "Random" then
                if self.LockedPartName then
                        local locked = char:FindFirstChild(self.LockedPartName)
                        if locked then return locked end
                end
                local name = RANDOM_PARTS[math.random(1, #RANDOM_PARTS)]
                self.LockedPartName = name
                return char:FindFirstChild(name) or root
        end
        return root
end

function TargetService:ReleaseTarget()
        self.CurrentTarget = nil
        self.TargetPart = nil
        self.LockedPartName = nil
end

function TargetService:KeepTarget(camera, screenCenter, scaledFOV)
        local target = self.CurrentTarget
        if not isValidEnemy(target) then return false end

        local part = self.TargetPart
        if not (part and part.Parent and part:IsDescendantOf(target.Character)) then
                return false
        end

        if State.WallCheck and not VisibilityService:CheckVisibility(target.Character, 1, part) then
                return false
        end

        local screenPoint, onScreen = camera:WorldToViewportPoint(part.Position)
        if not onScreen or screenPoint.Z <= 0 then return false end

        local dist = (Vector2.new(screenPoint.X, screenPoint.Y) - screenCenter).Magnitude
        return dist <= scaledFOV
end

function TargetService:AcquireTarget(camera, screenCenter, scaledFOV)
        local closestDist = scaledFOV
        local closestPlayer, bestPart = nil, nil

        local players = Players:GetPlayers()
        for i = 1, #players do
                local player = players[i]
                if isValidEnemy(player) then
                        local part = self:GetTargetPart(player.Character)
                        if part then
                                local screenPoint, onScreen = camera:WorldToViewportPoint(part.Position)
                                if onScreen and screenPoint.Z > 0 then
                                        local dist = (Vector2.new(screenPoint.X, screenPoint.Y) - screenCenter).Magnitude
                                        if dist < closestDist then
                                                if not State.WallCheck
                                                        or VisibilityService:CheckVisibility(player.Character, 1, part) then
                                                        closestDist = dist
                                                        closestPlayer = player
                                                        bestPart = part
                                                end
                                        end
                                end
                        end
                end
        end

        if closestPlayer then
                if closestPlayer ~= self.CurrentTarget then
                        self.LockedPartName = nil
                end
                self.CurrentTarget = closestPlayer
                self.TargetPart = bestPart
        end
end

-- ==========================================
-- 7. ADVANCED PREDICTION ENGINE
-- ==========================================
local TargetStates = {}
local MAX_SAMPLE_DT = 0.1
local MAX_PREDICTION_TIME = 5.0

local MAX_DV_PER_SAMPLE = 35
local SPIKE_COOLDOWN = 0.15
local MAX_ACCEL = 200
local ACCEL_TAU_BASE = 0.10
local MAX_ACCEL_LEAD = 12

local function clampAccelLead(v3)
        local m = v3.Magnitude
        if m > MAX_ACCEL_LEAD then return v3 * (MAX_ACCEL_LEAD / m) end
        return v3
end

task.spawn(function()
        while getgenv().SnyX_Running and task.wait(10) do
                for part in pairs(TargetStates) do
                        if typeof(part) ~= "Instance" or not part:IsDescendantOf(workspace) then
                                TargetStates[part] = nil
                        end
                end
        end
end)
CleanupManager:AddCustomCleanup(function() table.clear(TargetStates) end)

local function getKinematicPart(targetPart)
        local parent = targetPart.Parent
        if parent then
                local root = parent:FindFirstChild("HumanoidRootPart")
                if root and root:IsA("BasePart") then return root end
        end
        return targetPart
end

local function getTargetAcceleration(kinPart, targetVel, currentTime)
        local state = TargetStates[kinPart]

        if not state then
                TargetStates[kinPart] = {
                        lastVelocity = targetVel,
                        lastTime = currentTime,
                        smoothedAcceleration = Vector3.zero,
                        lastPredictionTime = nil,
                        spikeUntil = 0,
                        samples = 1
                }
                return Vector3.zero
        end

        local previousVelocity = state.lastVelocity
        local previousTime = state.lastTime
        local dt = currentTime - previousTime

        if dt <= 0 then
                return state.smoothedAcceleration or Vector3.zero
        end

        if dt > MAX_SAMPLE_DT then
                state.lastVelocity = targetVel
                state.lastTime = currentTime
                state.smoothedAcceleration = Vector3.zero
                state.lastPredictionTime = nil
                state.spikeUntil = 0
                return Vector3.zero
        end

        state.lastVelocity = targetVel
        state.lastTime = currentTime
        state.samples += 1

        if currentTime < state.spikeUntil then
                state.smoothedAcceleration = Vector3.zero
                return Vector3.zero
        end

        local dv = targetVel - previousVelocity

        if dv.Magnitude > MAX_DV_PER_SAMPLE then
                state.spikeUntil = currentTime + SPIKE_COOLDOWN
                state.smoothedAcceleration = Vector3.zero
                return Vector3.zero
        end

        local rawAcceleration = dv / dt
        local tau = ACCEL_TAU_BASE / math.clamp(State.PredReactivity or 1.0, 0.2, 3)
        local alpha = 1 - math.exp(-dt / tau)
        state.smoothedAcceleration = state.smoothedAcceleration:Lerp(rawAcceleration, alpha)

        local accelMag = state.smoothedAcceleration.Magnitude
        if accelMag > MAX_ACCEL then
                state.smoothedAcceleration = state.smoothedAcceleration * (MAX_ACCEL / accelMag)
        end
        return state.smoothedAcceleration
end

local function solveInterceptVector(shooterPos, targetPart, bulletSpeed, bulletGravityVec, deltaTime)
        if typeof(bulletSpeed) ~= "number" or bulletSpeed <= 0 then return nil end
        if typeof(shooterPos) ~= "Vector3" then return nil end
        if typeof(bulletGravityVec) ~= "Vector3" then return nil end
        if not targetPart or not targetPart:IsA("BasePart") then return nil end

        local dt = deltaTime or (1 / 60)
        local currentTime = os.clock()
        local targetPos = targetPart.Position

        local kinPart = getKinematicPart(targetPart)
        local targetVel = kinPart.AssemblyLinearVelocity
        local pingOffset = State.PingCompensation and (getPing() * 0.5) or 0
        local targetAcc = getTargetAcceleration(kinPart, targetVel, currentTime)

        local function f(t)
                local totalT = t + pingOffset
                local targetAtT = targetPos + (targetVel * totalT) + clampAccelLead(0.5 * targetAcc * (totalT ^ 2))
                local bulletDropAtT = 0.5 * bulletGravityVec * (t ^ 2)
                local requiredDisplacement = targetAtT - shooterPos - bulletDropAtT
                return (bulletSpeed * t) - requiredDisplacement.Magnitude
        end

        local t0 = 0
        local initialDist = (targetPos - shooterPos).Magnitude
        local t1 = (initialDist / bulletSpeed) + pingOffset

        if t1 <= 0 then return safeUnit(targetPos - shooterPos) end

        local f0 = f(t0)
        local f1 = f(t1)
        local t_intercept = t1
        local tolerance = 0.001

        for _ = 1, 8 do
                if math.abs(f1 - f0) < 1e-6 then break end
                local next_t = t1 - f1 * (t1 - t0) / (f1 - f0)
                if next_t ~= next_t or next_t == math.huge or next_t == -math.huge then
                        t_intercept = t1
                        break
                end
                t_intercept = math.clamp(next_t, 0, MAX_PREDICTION_TIME)
                if math.abs(t_intercept - t1) < tolerance then break end
                t0, f0 = t1, f1
                t1 = t_intercept
                f1 = f(t1)
        end

        local state = TargetStates[kinPart]
        if state then
                local prevPredictionTime = state.lastPredictionTime
                if prevPredictionTime then
                        local maxDelta = (State.PredMaxSlew or 3.0) * dt
                        t_intercept = prevPredictionTime
                                + math.clamp(t_intercept - prevPredictionTime, -maxDelta, maxDelta)
                end
                state.lastPredictionTime = t_intercept
        end

        local finalT = t_intercept + pingOffset
        local finalTargetPos = targetPos + (targetVel * finalT) + clampAccelLead(0.5 * targetAcc * (finalT ^ 2))
        local displacement = finalTargetPos - shooterPos

        if t_intercept > 0 then
                local requiredVelocity = (displacement / t_intercept) - (0.5 * bulletGravityVec * t_intercept)
                local finalUnit = safeUnit(requiredVelocity)
                if finalUnit then return finalUnit end
        end

        return safeUnit(displacement)
end

local lastGravVal, lastGravVec = nil, nil

local function getPredictedPosition(targetPart, shooterPos, deltaTime)
        local targetPos = targetPart.Position
        if not State.Prediction then return targetPos end

        if lastGravVal ~= WeaponService.Gravity then
                lastGravVal = WeaponService.Gravity
                lastGravVec = Vector3.new(0, -lastGravVal, 0)
        end

        local bulletSpeed = math.max(WeaponService.Speed, 1)
        local aimDirection = solveInterceptVector(shooterPos, targetPart, bulletSpeed, lastGravVec, deltaTime)
        if aimDirection then return shooterPos + (aimDirection * 10000) end

        return targetPos
end

