-- 5.1 ENEMY VALIDITY (Component Cache)
-- ==========================================
-- [PERF] แคช Humanoid/RootPart ต่อ player — จบการ FindFirstChild ทุกเฟรม
local PlayerCache = setmetatable({}, { __mode = "k" })

local function getComponents(player)
        local char = player.Character
        if not char then
                PlayerCache[player] = nil
                return nil
        end

        local entry = PlayerCache[player]
        if not entry or entry.Character ~= char then
                entry = {
                        Character = char,
                        Humanoid = char:FindFirstChildOfClass("Humanoid"),
                        Root = char:FindFirstChild("HumanoidRootPart")
                }
                PlayerCache[player] = entry
        end

        -- Humanoid บางทีโผล่ช้ากว่า character 1 เฟรม — เติมเมื่อขาด
        if not entry.Humanoid then
                entry.Humanoid = char:FindFirstChildOfClass("Humanoid")
        end
        return entry
end

local function isValidEnemy(player)
        if not player or player == LocalPlayer then return false end
        local entry = getComponents(player)
        if not entry then return false end

        local humanoid, root = entry.Humanoid, entry.Root
        if not humanoid or humanoid.Health <= 0 then return false end
        if not root or root.Parent ~= entry.Character then return false end
        if entry.Character:FindFirstChildOfClass("ForceField") then return false end
        if State.TeamCheck and player.Team and LocalPlayer.Team
                and player.Team == LocalPlayer.Team then
                return false
        end
        return true
end

CleanupManager:AddConn("PlayerRemovingCaches", Players.PlayerRemoving:Connect(function(player)
        PlayerCache[player] = nil
end))

