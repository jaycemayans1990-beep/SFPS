local TargetStates = {}
local MAX_SAMPLE_DT = 0.1
local MAX_PREDICTION_TIME = 5.0

-- [v2.3] กัน "จุดเล็งดีดขึ้นเอง" — velocity ของตัวละคร replicated มี impulse รั่วตลอด
-- (กระโดด +50Y ในเฟรมเดียว, server แก้ position → Δv ร้อย ๆ ใน dt ~16ms)
-- เดิม Δv/dt กลายเป็น accel 1,000-3,000 → lead ผี 0.5·a·t² หลักสิบ stud → กล้องเหวี่ยงตาม
local MAX_DV_PER_SAMPLE = 35   -- Δv ต่อตัวอย่างที่ humanoid ทำได้จริง (เกินนี้ = impulse/teleport ไม่ใช่ accel)
local SPIKE_COOLDOWN = 0.15    -- เจอ spike แล้วเชื่อ accel = 0 ช่วงสั้น ๆ (velocity ยังใช้จริงตามเดิม)
local MAX_ACCEL = 200          -- เพดาน |accel| ที่ป้อนเข้าสมการ (humanoid จริงแทบไม่เกินนี้)
local ACCEL_TAU_BASE = 0.10    -- τ ฐานของ EMA — หารด้วย PredReactivity (เร็วขึ้นไม่ผ่าน noise เฟรมเดียว)
local MAX_ACCEL_LEAD = 12      -- เพดานระยะ lead ที่มาจาก accel เท่านั้น (กัน t ยาว × accel ค้าง = ปลิว)
local VEL_TAU = 0.05           -- [v2.6-PERF] τ ของ EMA ความเร็ว — velocity replicated มาเป็นบันได ~20Hz
local VELOCITY_SANITY = 3000   -- [v2.9] เพดาน |velocity| ที่เชื่อได้ — เกินนี้ = replication glitch/NaN ไม่กินในสมการ
                               -- (แตะพื้น/เปลี่ยนทิศ = Δv ทั้งก้าวในเฟรมเดียว) เกลี่ยแล้ว lead ไม่สะดุ้ง

local function clampAccelLead(v3, cap)
        local m = v3.Magnitude
        if m > cap then return v3 * (cap / m) end
        return v3
end

