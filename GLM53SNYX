local ESPService = {
        Cache = {},
        COLOR_VISIBLE = Color3.fromRGB(0, 255, 128),
        COLOR_OBSTRUCTED = Color3.fromRGB(255, 50, 50),
        OUTLINE_VISIBLE = Color3.fromRGB(255, 215, 0),
        OUTLINE_OBSTRUCTED = Color3.fromRGB(100, 0, 0)
}

function ESPService:ClearAll()
        for _, player in ipairs(Players:GetPlayers()) do
                local char = player.Character
                if char then
                        local hl = char:FindFirstChild("ESP_Highlight")
                        if hl then hl:Destroy() end
                        local nt = char:FindFirstChild("ESP_NameTag")
                        if nt then nt:Destroy() end
                end
        end
        table.clear(self.Cache)
end
CleanupManager:AddCustomCleanup(function() ESPService:ClearAll() end)

CleanupManager:AddConn("PlayerRemovingESP", Players.PlayerRemoving:Connect(function(player)
        ESPService.Cache[player] = nil
end))

local function buildNameTag(char, head, text)
        local nameTag = Instance.new("BillboardGui")
        nameTag.Name = "ESP_NameTag"
        nameTag.Adornee = head
        nameTag.Size = UDim2.new(0, 150, 0, 30)
        nameTag.StudsOffset = Vector3.new(0, 2, 0)
        nameTag.AlwaysOnTop = true
        nameTag.MaxDistance = 1500

        local textLabel = Instance.new("TextLabel")
        textLabel.Name = "TagLabel"
        textLabel.Size = UDim2.new(1, 0, 1, 0)
        textLabel.BackgroundTransparency = 1
        textLabel.Text = text
        textLabel.TextStrokeTransparency = 0
        textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        textLabel.Font = Enum.Font.SourceSansBold
        textLabel.TextSize = 14
        textLabel.Parent = nameTag

        nameTag.Parent = char
        return nameTag
end

function ESPService:ProcessESP()
        local now = os.clock()
        local players = Players:GetPlayers()

        for i = 1, #players do
                local player = players[i]
                if player ~= LocalPlayer then
                        local char = player.Character

                        if not char then
                                self.Cache[player] = nil
                        else
                                local entry = self.Cache[player]
                                if not entry or entry.Character ~= char then
                                        entry = {
                                                Character = char,
                                                Visible = false,
                                                LastCheck = 0,
                                                Highlight = char:FindFirstChild("ESP_Highlight"),
                                                NameTag = char:FindFirstChild("ESP_NameTag"),
                                                ShownVisible = nil
                                        }
                                        self.Cache[player] = entry
                                end

                                local isEnemy = isValidEnemy(player)

                                if not isEnemy or (not State.ESP and not State.ESPName) then
                                        if entry.Highlight then entry.Highlight:Destroy(); entry.Highlight = nil end
                                        if entry.NameTag then entry.NameTag:Destroy(); entry.NameTag = nil end
                                        entry.ShownVisible = nil
                                else
                                        if now - entry.LastCheck >= 0.35 then
                                                entry.Visible = VisibilityService:CheckVisibility(char, 5, nil)
                                                entry.LastCheck = now
                                        end

                                        if State.ESP then
                                                local hl = entry.Highlight
                                                if not hl or hl.Parent ~= char then
                                                        hl = Instance.new("Highlight")
                                                        hl.Name = "ESP_Highlight"
                                                        hl.FillTransparency = 0.25
                                                        hl.Parent = char
                                                        entry.Highlight = hl
                                                        entry.ShownVisible = nil
                                                end
                                                if entry.ShownVisible ~= entry.Visible then
                                                        hl.FillColor = entry.Visible and self.COLOR_VISIBLE or self.COLOR_OBSTRUCTED
                                                        hl.OutlineColor = entry.Visible and self.OUTLINE_VISIBLE or self.OUTLINE_OBSTRUCTED
                                                        entry.ShownVisible = entry.Visible
                                                end
                                        elseif entry.Highlight then
                                                entry.Highlight:Destroy()
                                                entry.Highlight = nil
                                                entry.ShownVisible = nil
                                        end

                                        if State.ESPName then
                                                local head = char:FindFirstChild("Head")
                                                if head then
                                                        local nt = entry.NameTag
                                                        if not nt or nt.Parent ~= char then
                                                                entry.NameTag = buildNameTag(char, head, player.Name)
                                                                nt = entry.NameTag
                                                        end
                                                        local color = entry.Visible and self.COLOR_VISIBLE or self.COLOR_OBSTRUCTED
                                                        local label = nt:FindFirstChild("TagLabel")
                                                        if label and label.TextColor3 ~= color then
                                                                label.TextColor3 = color
                                                        end
                                                elseif entry.NameTag then
                                                        entry.NameTag:Destroy()
                                                        entry.NameTag = nil
                                                end
                                        elseif entry.NameTag then
                                                entry.NameTag:Destroy()
                                                entry.NameTag = nil
                                        end
                                end
                        end
                end
        end
end

