local function connectGuardedLoop(connName, reportLabel, signal, fn, reportAt)
        local errStreak = 0
        CleanupManager:AddConn(connName, signal:Connect(function(...)
                local ok, err = xpcall(fn, traceFn, ...)
                if ok then
                        errStreak = 0
                else
                        errStreak += 1
                        if errStreak == reportAt then
                                log("ERROR", reportLabel .. " error: " .. tostring(err))
                                if setStickyStatus then
                                        setStickyStatus(reportLabel:lower() .. " error: " .. tostring(err):sub(1, 40))
                                end
                        end
                end
        end))
end

local function connectESP()
        connectGuardedLoop("ESP_Heartbeat", "ESP tick", RunService.Heartbeat, function(dt)
                lastEspTick = os.clock()
                espAccumulator += dt
                if espAccumulator >= ESP_INTERVAL then
                        espAccumulator = 0
                        espProcessFn()
                end
        end, 5)
end
