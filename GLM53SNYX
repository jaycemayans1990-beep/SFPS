local lastRenderTick = os.clock()
local function renderTick(deltaTime)
        local camera = getCamera()
        if not camera then return end

        local now = os.clock()
        local vp = camera.ViewportSize
        local screenCenter = Vector2.new(vp.X * 0.5, vp.Y * 0.5)
        TriggerBot.update(camera, screenCenter, vp)

        local userLook = camera.CFrame.LookVector
        local dtSafe = math.max(deltaTime, 1e-4)
        local userDps = math.huge
        if prevReadLook then
                local uDeg = angleBetweenDeg(userLook, prevReadLook)
                if uDeg > 0.05 then userDps = uDeg / dtSafe end
        end
        if lastWriteLook then
                local wDeg = angleBetweenDeg(userLook, lastWriteLook)
                local againstPull = false
                if prevReadLook then
                        local pullAxis = prevReadLook:Cross(lastWriteLook)
                        local handAxis = lastWriteLook:Cross(userLook)
                        againstPull = pullAxis:Dot(handAxis) < 0
                end
                if againstPull or wDeg / dtSafe < userDps then
                        userDps = wDeg / dtSafe
                end
        end
        if userDps == math.huge then userDps = 0 end
        local handAxisRaw = nil
        if lastWriteLook then
                handAxisRaw = lastWriteLook:Cross(userLook)
        elseif prevReadLook then
                handAxisRaw = prevReadLook:Cross(userLook)
        end
        prevReadLook = userLook
        lastWriteLook = nil

        local handAway = true
        local gatePart = TargetService.TargetPart
        if gatePart and gatePart.Parent then
                local toTarget = safeUnit(gatePart.Position - camera.CFrame.Position)
                local aimAxis = toTarget and safeUnit(userLook:Cross(toTarget))
                local handAxis = handAxisRaw and safeUnit(handAxisRaw)
                if aimAxis and handAxis then
                        handAway = handAxis:Dot(aimAxis) < 0
                end
        end
        if State.DragSwitch and handAway and userDps > (State.FlickSpeed or 140) then
                if not flickArmStart then flickArmStart = now end
                if now - flickArmStart >= FLICK_ARM then
                        flickUntil = now + FLICK_HOLD
                end
        else
                flickArmStart = nil
        end

        local zoomRaw = getZoomScale(camera)
        if not zoomSmoothed then
                zoomSmoothed = zoomRaw
        else
                zoomSmoothed += (zoomRaw - zoomSmoothed) * (1 - math.exp(-deltaTime / ZOOM_TAU))
        end

        local scaledFOV = State.FOV * (vp.Y / 1080)

        if State.ShowFOV then
                FOVCircle.Position = screenCenter
                FOVCircle.Radius = scaledFOV
                FOVCircle.Visible = true
        elseif FOVCircle.Visible then
                FOVCircle.Visible = false
        end

        if not State.Aimbot or not hasActiveWeapon() then
                if TargetService.CurrentTarget then TargetService:ReleaseTarget() end
                prevErrDeg = nil
                steerInfluence = 1
                steerHoldStart = nil
                return
        end

        if State.DragSwitch and now < flickUntil then
                if TargetService.CurrentTarget then
                        banTargetAndRelease(TargetService.CurrentTarget, FLICK_SWITCH_COOLDOWN)
                end
                steerInfluence = 1
                steerHoldStart = nil
                prevErrDeg = nil
                return
        end

        if switchAwayPlayer and now >= switchCooldownUntil then
                switchAwayPlayer = nil
        end

        if TargetService.CurrentTarget then
                if not isValidEnemy(TargetService.CurrentTarget) then
                        TargetService:ReleaseTarget()
                elseif TargetService:KeepTarget(camera, screenCenter, scaledFOV) then
                        targetGraceUntil = 0
                else
                        if targetGraceUntil == 0 then
                                targetGraceUntil = now + TARGET_GRACE
                        end
                        local part = TargetService.TargetPart
                        local onScreen = part and screenDistSq(camera, part.Position, screenCenter) ~= nil
                        if not onScreen or now >= targetGraceUntil then
                                TargetService:ReleaseTarget()
                        end
                end
        end

        if not TargetService.CurrentTarget then
                TargetService:AcquireTarget(camera, screenCenter, scaledFOV)
        end

        if State.SwitchAssist and TargetService.CurrentTarget then
                TargetService:CheckSwitch(camera, screenCenter, scaledFOV)
        end

        local targetPart = TargetService.TargetPart
        if TargetService.CurrentTarget and targetPart and targetPart.Parent then
                local shooterPos = camera.CFrame.Position
                local zoomScale = zoomSmoothed
                local baseRate = (10 + State.Smoothness * 30) * zoomScale

                local leadTau = State.LagComp and math.min(1 / baseRate, 0.15) or 0
                local targetPos = getPredictedPosition(targetPart, shooterPos, deltaTime, leadTau, zoomScale)

                local desiredDirection = safeUnit(targetPos - shooterPos)
                if desiredDirection then
                        local errDeg = angleBetweenDeg(camera.CFrame.LookVector, desiredDirection)
                        local errScaled = errDeg * zoomScale
                        local gain = State.TrackBoost or 1.5

                        if now - lastAimWriteClock > 0.1 then
                                prevDesiredDir = nil
                                desSmoothed = 0
                        end
                        local desAngDps = 0
                        if prevDesiredDir and prevDesiredDir:Dot(desiredDirection) < 0.9999995 then
                                desAngDps = angleBetweenDeg(prevDesiredDir, desiredDirection) / dtSafe
                        end
                        prevDesiredDir = desiredDirection
                        desSmoothed += (desAngDps - desSmoothed) * (1 - math.exp(-dtSafe / DES_ANG_TAU))
                        desSmoothed = math.min(desSmoothed, DES_ANG_MAX_DPS)
                        local trackCap = math.max(MAX_TRACK_DPS, desSmoothed * TRACK_MARGIN)
                        local effSpeed = math.min(baseRate + errScaled * gain, trackCap)
                        local sdt = math.min(deltaTime, 1 / 30)
                        local alpha = 1 - math.exp(-effSpeed * sdt)

                        if errDeg < AIM_MICRO_SMOOTH_DEG then
                                alpha *= AIM_MICRO_MIN + (1 - AIM_MICRO_MIN) * (errDeg / AIM_MICRO_SMOOTH_DEG)
                        end

                        local maxStepDps = (MAX_STEP_BASE + State.Smoothness * MAX_STEP_SPAN) * zoomScale
                        alpha = math.min(alpha, (maxStepDps * sdt) / math.max(errDeg, 0.05))

                        local handAssisting = false
                        if handAxisRaw then
                                local aimAxis = safeUnit(userLook:Cross(desiredDirection))
                                local handAxis = safeUnit(handAxisRaw)
                                if aimAxis and handAxis and handAxis:Dot(aimAxis) > 0 then
                                        handAssisting = true
                                end
                        end
                        local steering = State.FreeSteer and userDps > STEER_DPS
                                and prevErrDeg ~= nil and errDeg > prevErrDeg + 0.05
                                and not handAssisting
                        if steering then
                                if not steerHoldStart then steerHoldStart = now end
                                if State.DragSwitch and now - steerHoldStart >= STEER_HOLD then
                                        banTargetAndRelease(TargetService.CurrentTarget, FLICK_SWITCH_COOLDOWN)
                                        flickUntil = now + FLICK_HOLD
                                        return
                                end
                        else
                                steerHoldStart = nil
                        end
                        local infTarget = steering and STEER_MIN_INFLUENCE or 1
                        steerInfluence += (infTarget - steerInfluence) * (1 - math.exp(-deltaTime / STEER_TAU))

                        alpha = math.clamp(alpha, 0, 1)
                        steerInfluence = math.clamp(steerInfluence, 0, 1)
                        local smoothDirection = safeUnit(camera.CFrame.LookVector:Lerp(desiredDirection, alpha * steerInfluence))
                        if smoothDirection then
                                local ok, newCFrame = pcall(CFrame.lookAt, shooterPos, shooterPos + smoothDirection)
                                if ok and newCFrame then
                                        camera.CFrame = newCFrame
                                        lastWriteLook = smoothDirection
                                        lastAimWriteClock = now
                                end
                        end
                        prevErrDeg = errDeg
                end
        end

end

