-- ==========================================
-- 3. MATH HELPERS
-- ==========================================
-- [v2.9] เวกเตอร์ "มีตัวเลขจริง" ทุกแกน (ไม่ใช่ NaN/Inf) — ตัวเลขพังจาก replication
-- ถ้าลอดไปถึง camera CFrame = เรนเดอร์คำนวณพังทั้งระบบ เกมล้มได้ — ใช้เป็นด่านแรกของทุกเส้นทาง
local function isFiniteVec3(v)
        if typeof(v) ~= "Vector3" then return false end
        local x, y, z = v.X, v.Y, v.Z
        if x ~= x or y ~= y or z ~= z then return false end -- NaN ≠ NaN
        return x < math.huge and x > -math.huge
                and y < math.huge and y > -math.huge
                and z < math.huge and z > -math.huge
end

local function safeUnit(v3)
        if not isFiniteVec3(v3) then return nil end -- [v2.9] เดิม NaN/Inf ลอดผ่าน (NaN <= 1e-6 เป็น false)
        local mag = v3.Magnitude
        if not (mag > 1e-6 and mag < math.huge) then return nil end
        local unit = v3 / mag
        return isFiniteVec3(unit) and unit or nil
end
