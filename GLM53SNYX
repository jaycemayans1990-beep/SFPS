-- → manual drag เฉพาะ handle ที่กำหนด กด slider/toggle แล้วหน้าต่างไม่ขยับ
local dragConnIndex = 0
local function enableDrag(handle, target)
        local dragging = false
        local dragStart, startPos

        dragConnIndex += 1
        CleanupManager:AddConn("DragBegan" .. dragConnIndex, handle.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        dragStart = input.Position
                        startPos = target.Position
                end
        end))

        dragConnIndex += 1
        CleanupManager:AddConn("DragEnded" .. dragConnIndex, handle.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                end
        end))

        dragConnIndex += 1
        CleanupManager:AddConn("DragMoved" .. dragConnIndex, UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                        or input.UserInputType == Enum.UserInputType.Touch) then
                        local delta = input.Position - dragStart
                        target.Position = UDim2.new(
                                startPos.X.Scale, startPos.X.Offset + delta.X,
                                startPos.Y.Scale, startPos.Y.Offset + delta.Y
                        )
                end
        end))
end

