        expect("เพิ่งปล่อยยังไม่ถึง gap = รอ", triggerDecision(1.0, true, false, 0, 0.95) == "wait")

        expect("Auto มือถือ = VirtualUser → Press ไม่มี VIM",
                table.concat(backendOrder(true, "Auto"), ",") == "VirtualUser,Press")
        expect("Auto PC = Press → VIM → VirtualUser",
                table.concat(backendOrder(false, "Auto"), ",") == "Press,VIM,VirtualUser")
        expect("บังคับ VIM = ได้ตามสั่ง (รับความเสี่ยงเอง)",
                table.concat(backendOrder(true, "VIM"), ",") == "VIM")
        expect("บังคับ Press = Press เดียว",
                table.concat(backendOrder(false, "Press"), ",") == "Press")
        expect("ค่าไม่รู้จัก = ถือเป็น Auto",
                table.concat(backendOrder(true, "ค่าแปลก"), ",") == "VirtualUser,Press")

        local mockCam = { WorldToViewportPoint = function(_, p)
                return Vector3.new(p.X + 3, p.Y + 4, 5), true
        end }
        expect("ระยะ²บนจอ 3-4 = 25", screenDistSq(mockCam, Vector3.new(0, 0, 0), Vector2.new(0, 0)) == 25)
        local mockCam = { WorldToViewportPoint = function(_, p)
                return Vector3.new(p.X + 3, p.Y + 4, 5), true
        end }
        expect("ระยะ²บนจอ 3-4 = 25", screenDistSq(mockCam, Vector3.new(0, 0, 0), Vector2.new(0, 0)) == 25)
        local mockOffCam = { WorldToViewportPoint = function() return Vector3.new(9, 9, 9), false end }
        expect("จุดนอกจอ = nil", screenDistSq(mockOffCam, Vector3.new(0, 0, 0), Vector2.new(0, 0)) == nil)

        expect("มุมทิศเดียวกัน = 0°", angleBetweenDeg(Vector3.xAxis, Vector3.xAxis) < 1e-9)
        expect("มุมตั้งฉาก = 90°", math.abs(angleBetweenDeg(Vector3.xAxis, Vector3.yAxis) - 90) < 1e-9)

        log("INFO", ("self-test: %d passed, %d failed"):format(passed, failed))
end
