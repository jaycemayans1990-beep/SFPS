local TRIGGER_BADGE_Y = 26

function TriggerBot.update(camera, screenCenter, vp)
        local rt = TriggerBot
        local now = os.clock()

        local active = State.TriggerBot and State.Aimbot and firePress ~= nil
                and hasActiveWeapon() and now >= flickUntil

        local onTarget = false
        if active then
                local part = TargetService.TargetPart
                if part and part.Parent and TargetService.CurrentTarget then
                        local radiusPx = (State.TriggerRadius or TRIGGER_RADIUS_DEFAULT) * (vp.Y / 1080)
                        local distSq = screenDistSq(camera, part.Position, screenCenter)
                        onTarget = distSq ~= nil and distSq <= radiusPx * radiusPx
                end
        end

        if rt.pressed and not active then
                rt.pressed = false
                rt.lastRelease = now
                releaseOrFallback()
        end

        local action = triggerDecision(now, onTarget, rt.pressed, rt.pressStart, rt.lastRelease)
        if action == "press" then
                if pcall(firePress) then
                        rt.pressed = true
                        rt.pressStart = now
                else
                        rt.pressed = false
                        if not pickNextBackend("fallback หลัง " .. tostring(fireName) .. " error") then
                                triggerBackendExhausted("ส่งคลิกไม่สำเร็จและไม่เหลือ backend")
                        end
                end
        elseif action == "release" then
                releaseOrFallback()
                rt.pressed = false
                rt.lastRelease = now
        end

        if triggerBadge then
                local want = State.TriggerBot
                if want ~= triggerBadge.Visible then
                        triggerBadge.Visible = want
                end
                if triggerBadge.Visible then
                        local halfX = vp.X * 0.5
                        if badgeLastHalfX ~= halfX then
                                triggerBadge.Position = Vector2.new(halfX, TRIGGER_BADGE_Y)
                                badgeLastHalfX = halfX
                        end
                        local newColor = rt.pressed and TRIGGER_COLOR_FIRING or TRIGGER_COLOR_READY
                        local newText = rt.pressed and "TRIGGER — ยิง" or "TRIGGER ON"
                        if triggerBadge.Color ~= newColor then triggerBadge.Color = newColor end
                        if triggerBadge.Text ~= newText then triggerBadge.Text = newText end
                end
        end
end

