FOVCircle.Transparency = 0.7
FOVCircle.Visible = false
CleanupManager:AddDrawing("FOVCircle", FOVCircle)

local function hasActiveWeapon()
        local character = LocalPlayer and LocalPlayer.Character
        return character ~= nil and character:FindFirstChildOfClass("Tool") ~= nil
end

-- ==========================================
-- 9.5 TRIGGER BOT (v2.8 — auto fire when crosshair on enemy)
-- ==========================================
local VirtualUser = game:GetService("VirtualUser")

local TRIGGER_MIN_HOLD = 0.04      -- กดค้างขั้นต่ำ (วิ.) ให้ปืน semi-auto แคตช์คลิกทัน
local TRIGGER_RELEASE_GRACE = 0.07 -- หลุดเป้านานเท่านี้ (วิ.) ค่อยปล่อยคลิก — ขอบเป้าไม่สะดุ้ง
local TRIGGER_CYCLE_GAP = 0.12     -- [v2.9] เว้นช่วงขั้นต่ำระหว่างไซเคิลคลิก — จังหวะเป็นมนุษย์ ไม่รัวเกินกาย
local TRIGGER_RAY_DIST = 2048

local triggerRayParams = RaycastParams.new()
triggerRayParams.FilterType = Enum.RaycastFilterType.Exclude
triggerRayParams.IgnoreWater = true

local triggerState = "idle"   -- idle → pending (เจอเป้า รอดีเลย์) → firing (กดค้าง)
local triggerPendingAt = 0
local triggerDelayUsed = 0
local triggerFiredAt = 0
local triggerOffSince = nil
local triggerIdleSince = 0
local triggerChannel = "vu"
-- [v2.9] จำสถานะคลิกของตัวเอง — หัวใจของการแก้ "เกมปิดเองตอนเข้าเป้า":
-- IsMouseButtonPressed ไม่รู้ว่าใครเป็นคนกด — คลิกสังเคราะห์ของเรามันเห็นเหมือนกัน
-- เดิม: กด → เฟรมถัดไปคิดว่า "ผู้เล่นกดเอง" → ปล่อย → คิดว่าว่าง → กดใหม่ …
-- วนกด/ปล่อยรัวทุกเฟรม = input bridge โดนถล่มหนัก = เกมตัดดับ — ต่อให้ flag นี้ไว้เสมอ
local triggerHeld = false

-- [v2.9] กด 2 ชั้น: Safe = VirtualUser ก่อน (input ระดับ engine เสถียรสุด — ไม่แตะ
-- mouse bridge ของผู้เช่า) / ปิด Safe = mouse1press ตรง ๆ — ช่องไหนพังไปช่องถัดไป มี pcall ครบ
local function fireInputDown()
        local cam = getCamera()
        local order = (State.TriggerSafeInput ~= false) and { "vu", "m1" } or { "m1", "vu" }
        for _, ch in ipairs(order) do
                local ok = false
                if ch == "vu" and cam then
                        ok = pcall(function()
                                VirtualUser:CaptureController()
                                VirtualUser:Button1Down(cam.ViewportSize * 0.5, cam.CFrame)
                        end)
                elseif ch == "m1" and type(mouse1press) == "function" then
                        ok = pcall(mouse1press)
                end
                if ok then
                        triggerChannel = ch
                        return true
                end
        end
        return false
end

-- ปล่อยต้องใช้ "ช่องเดียวกับที่กด" — กดช่อง m1 แต่ปล่อยช่อง vu = ปืนค้างยิงไม่หยุด
local function fireInputUp()
        local cam = getCamera()
        if triggerChannel == "m1" and type(mouse1release) == "function" then
                if pcall(mouse1release) then return true end
        end
        if cam then
                return pcall(function()
                        VirtualUser:Button1Up(cam.ViewportSize * 0.5, cam.CFrame)
                end)
        end
        return false
end

local function triggerPress()
        if fireInputDown() then
                triggerHeld = true
                return true
        end
        return false -- ทุกช่องทางพัง = อย่าเข้าสถานะ firing (กันคลิกค้างที่ปล่อยไม่ได้)
end

local function triggerRelease()
        if triggerHeld then
                fireInputUp()
                triggerHeld = false
        end
end

local function triggerReset()
        triggerRelease()
        triggerState = "idle"
        triggerOffSince = nil
        triggerIdleSince = os.clock()
end

-- กันเมาส์ค้าง: ถ้าสคริปต์ถูกล้าง/รีรันขณะคลิกค้าง ต้องปล่อยคลิกก่อน
CleanupManager:AddCustomCleanup(function()
        triggerRelease()
        triggerState = "idle"
end)

-- หา "ศัตรูใต้จุดเล็ง" — 2 ทาง: ล็อคเป้าอยู่ = เช็คมุมคลาดของ part ที่ล็อค (ไวกว่า เพราะ
-- aimbot กำลังดันจุดเล็งเข้าหาอยู่แล้ว) / ไม่ล็อค = ray กลางจอ (กำแพงตัดเอง ยิงทะลุไม่ได้)
-- [v2.10] ทั้งสองทางยืนยันเส้นสายตาก่อนยิงเสมอ — เดิมฝั่งล็อคเช็คกำแพงด้วย
-- State.WallCheck ของ aimbot (default OFF) = ยิงใส่กำแพงตอนล็อคทะลุ/เป้าเพิ่งหลบหลังบังเก็นได้
local function findTriggerTarget(camera)
        local shooterPos = camera.CFrame.Position
        local look = camera.CFrame.LookVector

        local targetPart = TargetService.TargetPart
        if TargetService.CurrentTarget and targetPart and targetPart.Parent then
                local toTarget = safeUnit(targetPart.Position - shooterPos)
                if not toTarget then return nil end
                local errDeg = math.deg(math.acos(math.clamp(look:Dot(toTarget), -1, 1)))
                if errDeg > (State.TriggerAngle or 0.7) then return nil end
                -- [v2.10] wall check ของ trigger เอง (default ON) — แยกจาก Wall Check ของ aimbot
                -- เช็คเส้นสายตาถึงจุดเล็งจริงทุกเฟรมก่อนยิง; ทะลุพุ่มไม้/กระจกใสได้ (pierce 1 ชั้น)
                if State.TriggerWallCheck ~= false and not VisibilityService:CheckVisibility(
                        TargetService.CurrentTarget.Character, 1, targetPart) then
                        return nil
                end
                return TargetService.CurrentTarget
        end

        local myChar = LocalPlayer and LocalPlayer.Character
        local scratch = { camera }
        if myChar then scratch[2] = myChar end
        triggerRayParams.FilterDescendantsInstances = scratch
        local hit = Workspace:Raycast(shooterPos, look * TRIGGER_RAY_DIST, triggerRayParams)
        if not hit then return nil end

        local node = hit.Instance
        while node and node ~= Workspace do
                if node:IsA("Model") and node:FindFirstChildOfClass("Humanoid") then
                        local player = Players:GetPlayerFromCharacter(node)
                        if player and isValidEnemy(player) then return player end
                        return nil -- NPC/เพื่อน/ตัวไม่ใช่ศัตรู → ไม่ยิง
                end
                node = node.Parent
        end
        return nil
end

-- สเตตแมชชีน: เจอเป้า → รอดีเลย์ (reaction time + จิตเตอร์ ไม่หุ่น) → รอจุดเล็งนิ่ง → กด
-- → ค้างตราบใดที่บนเป้า → ปล่อย (aimBusy = กล้องกำลัง snap/ไกล่/สะบัด — รอนิ่งก่อนค่อยกด)
local function runTriggerBot(camera, aimBusy)
        if not State.TriggerBot or not hasActiveWeapon() then
                if triggerState ~= "idle" then triggerReset() end
                return
        end
        -- ผู้เล่นกดยิงเองอยู่ (และเราไม่ได้เป็นคนกด) → ถอนมือ ไม่แย่งคลิก — [v2.9] กันสับสน
        -- คลิกสังเคราะห์ของตัวเอง (จุดที่ทำให้ v2.8 เกมปิดเอง)
        if not triggerHeld and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                if triggerState ~= "idle" then triggerReset() end
                return
        end

        local now = os.clock()
        local onTarget = findTriggerTarget(camera) ~= nil

        if triggerState == "idle" then
                if onTarget and (now - triggerIdleSince) >= TRIGGER_CYCLE_GAP then
                        triggerState = "pending"
                        triggerPendingAt = now
                        -- จิตเตอร์ ±15% สุ่มครั้งเดียวต่อการเข้าเป้า (ไม่ใช่ต่อเฟรม)
                        local base = math.max((State.TriggerDelay or 90) / 1000, 0)
                        triggerDelayUsed = base * (0.85 + math.random() * 0.3)
                end
        elseif triggerState == "pending" then
                if not onTarget then
                        triggerState = "idle" -- เป้าหลุดก่อนครบดีเลย์ → ยกเลิก
                        triggerIdleSince = now
                elseif now - triggerPendingAt >= triggerDelayUsed and not aimBusy then
                        -- [v2.9] รอจุดเล็งนิ่งก่อนกด — คลิกกลางการ snap/ไกล่กล้อง = จังหวะแปลก
                        -- (ทั้งเรื่อง anti-cheat อ่าน input และความนิ่งของเลนส์)
                        if triggerPress() then
                                triggerState = "firing"
                                triggerFiredAt = now
                        else
                                triggerState = "idle" -- ยิงไม่ออกทุกช่องทาง → เริ่มไซเคิลใหม่
                                triggerIdleSince = now
                        end
                end
        else -- firing
                if onTarget then
                        triggerOffSince = nil
                elseif not triggerOffSince then
                        triggerOffSince = now
                end
                local offLong = triggerOffSince and (now - triggerOffSince) >= TRIGGER_RELEASE_GRACE
                if offLong and (now - triggerFiredAt) >= TRIGGER_MIN_HOLD then
                        triggerRelease()
                        triggerState = "idle"
                        triggerOffSince = nil
                        triggerIdleSince = now
                end
        end
end

-- [v2.7] วัด "การหมุนที่มาจากมือผู้เล่น" ให้สะอาดจากอิทธิพลของเรา (แก้จุดอ่อน v2.6)
--   v2.6 เทียบกล้องกับ lastAimLook (ที่เราเขียน) → ตอน track เป้าไว ตัวเลขปนความเร็ว
--   ที่เราดึงกล้องเอง → หลุดเกณฑ์ง่าย → ปล่อยล็อค-จับใหม่วนลูป = กระตุก
--   v2.7 วัด 2 ฐานแล้วเลือกค่าต่ำสุด ตัดอิทธิพลของเราออกทั้งสองโมเดลกล้อง:
--   (a) เทียบผลอ่านกล้อง 2 เฟรม (อ่านตอนต้นเฟรม ก่อนที่เราจะเขียนเสมอ)
--   (b) เทียบผลอ่านกับ CFrame ล่าสุดที่เราเขียน
local flickUntil = 0
local prevReadLook = nil
local lastWriteLook = nil
local FLICK_HOLD = 0.10          -- พักเล็งหลังสะบัด (สั้นลง = ล็อคเป้าใหม่ไวขึ้น)
local STEER_DPS = 45             -- เกณฑ์ "ผู้เล่นกำลังลากกล้องหนีเป้า" (°/s)
local STEER_HOLD = 0.22          -- ลากหนีค้างนานนี้ = ตีความว่าต้องการสลับเป้า → ปล่อยล็อค
local STEER_MIN_INFLUENCE = 0.15 -- แรงดึงคงเหลือตอนผู้เล่นลากหนี (มือนำเกือบเต็ม ไม่ตีค้อน)
local STEER_TAU = 0.07           -- ความไวการผ่อน/คืนแรงดึง (วิ.)
local SWITCH_EASE_SPEED = 30     -- เพิ่งล็อค/สลับเป้า: ไกล่เข้าเป้า ~100ms แทนจุ๊บเดียว
local SWITCH_EASE_TIME = 0.15
local SWITCH_EASE_MIN_ERR = 3    -- คลาดน้อยกว่านี้ (° สเกลซูม) ไม่ต้องไกล่

local steerInfluence = 1
local steerHoldStart = nil
local switchEaseUntil = 0
local prevAimKey = nil
local prevErrDeg = nil

CleanupManager:AddConn("RenderStep", RunService.RenderStepped:Connect(function(deltaTime)
        local camera = getCamera()
        if not camera then return end

        -- [v2.7] วัดความเร็วหมุนจากมือผู้เล่น (°/s) — อ่านตอนต้นเฟรมก่อนที่เราจะเขียนกล้อง
        local userLook = camera.CFrame.LookVector
        local dtSafe = math.max(deltaTime, 1e-4)
        local userDps = math.huge
        if prevReadLook then
                local uDot = math.clamp(userLook:Dot(prevReadLook), -1, 1)
                local uDeg = math.deg(math.acos(uDot))
                if uDeg > 0.05 then userDps = uDeg / dtSafe end
        end
        if lastWriteLook then
                local wDot = math.clamp(userLook:Dot(lastWriteLook), -1, 1)
                local wDeg = math.deg(math.acos(wDot))
                if wDeg > 0.05 and wDeg / dtSafe < userDps then
                        userDps = wDeg / dtSafe
                end
        end
        if userDps == math.huge then userDps = 0 end
        prevReadLook = userLook
        lastWriteLook = nil

        -- [v2.7] ปัดแรงพอ → ต่ออายุหน้าต่างปล่อยล็อค (ปัดต่อเฟรมไหนก็ต่ออายุเอง
        -- = สะบัดยาวเท่าไรก็ปล่อยจนถึงปลายมือ ไม่โดนดูดกลับกลางทาง)
        if State.DragSwitch and userDps > (State.FlickSpeed or 140) then
                flickUntil = os.clock() + FLICK_HOLD
        end

        -- [v2.6-PERF] เกลี่ย zoomScale — ตอนสกรอลล์ซูม FOV เด้งทีละ step ทำให้ speed/boost/เกณฑ์ snap
        -- กระโดดตาม (รู้สึกกระตุกช่วงซูม) → EMA 80ms ทำให้ทุกพารามิเตอร์ไหลต่อเนื่อง
        local zoomRaw = getZoomScale(camera)
        if not zoomSmoothed then
                zoomSmoothed = zoomRaw
        else
                zoomSmoothed += (zoomRaw - zoomSmoothed) * (1 - math.exp(-deltaTime / ZOOM_TAU))
        end

        -- [PERF] คำนวณ scaled FOV ครั้งเดียวต่อเฟรม (เดิมคิดซ้ำ 3 จุด)
        local vp = camera.ViewportSize
        local screenCenter = Vector2.new(vp.X * 0.5, vp.Y * 0.5)
        local scaledFOV = State.FOV * (vp.Y / 1080)

        -- [BUG 11 FIX] อัปเดตวง FOV เฉพาะตอนแสดงผล
        if State.ShowFOV then
                FOVCircle.Position = screenCenter
                FOVCircle.Radius = scaledFOV
                FOVCircle.Visible = true
        elseif FOVCircle.Visible then
                FOVCircle.Visible = false
        end

        if not State.Aimbot or not hasActiveWeapon() then
                if TargetService.CurrentTarget then TargetService:ReleaseTarget() end
                prevErrDeg = nil
                steerInfluence = 1
                steerHoldStart = nil
                prevAimKey = nil
                runTriggerBot(camera, false) -- [v2.8] triggerbot สแตนด์อโลนได้ (ไม่ต้องเปิด aimbot)
                return
        end

        -- [v2.5/v2.7] กำลังสะบัดจอ → ปล่อยล็อค + พักเล็ง (หน้าต่างถูกต่ออายุจากด้านบน)
        if State.DragSwitch and os.clock() < flickUntil then
                if TargetService.CurrentTarget then
                        -- [v2.7] จำเป้าที่เพิ่งสะบัดหนี + คูลดาวน์ — acquire ไม่ดูดกลับทันที = ไม่เหนียว
                        switchAwayKey = TargetService.CurrentTarget
                        switchCooldownUntil = os.clock() + SWITCH_COOLDOWN
                        TargetService:ReleaseTarget()
                end
                steerInfluence = 1
                steerHoldStart = nil
                prevErrDeg = nil
                prevAimKey = nil -- [v2.7] re-lock หลังสะบัด = ได้ switch ease เสมอ (ไม่จุ๊บกลับ)
                triggerReset() -- [v2.8] สะบัด = ยกเลิกการยิงอัตโนมัติระหว่างสะบัด
                return
        end

        -- [v2.7] คูลดาวน์หมดอายุ → คืนสิทธิ์จับเป้าเดิมตามปกติ
        if switchAwayKey and os.clock() >= switchCooldownUntil then
                switchAwayKey = nil
        end

        -- [v2.6-PERF] แยกหลุด "ถาวร" กับ "ชั่วคราว" — ตาย/ออกเกม ปล่อยทันที / ล่อขอบวง-กำแพงกระพริบ
        -- ใจเย็น 0.25s (เดิมปล่อยทันที → acquire → snap กลับ = วงล้อกระตุกตอนเป้าวิ่งขอบวง)
        -- ถ้าเป้าหลุดออกนอกจอ = ปล่อยทันทีเหมือนเดิม (กันกล้องไล่หมุนตามเป้าที่มองไม่เห็น)
        if TargetService.CurrentTarget then
                if not isValidEnemy(TargetService.CurrentTarget) then
                        TargetService:ReleaseTarget()
                elseif TargetService:KeepTarget(camera, screenCenter, scaledFOV) then
                        targetGraceUntil = 0
                else
                        if targetGraceUntil == 0 then
                                targetGraceUntil = os.clock() + TARGET_GRACE
                        end
                        local part = TargetService.TargetPart
                        local onScreen = false
                        if part then
                                local sp, isOn = camera:WorldToViewportPoint(part.Position)
                                onScreen = isOn and sp.Z > 0
                        end
                        if not onScreen or os.clock() >= targetGraceUntil then
                                TargetService:ReleaseTarget()
                        end
                end
        end

        -- [v2.7] acquire ทุกเฟรมตอนว่าง (เดิม 30Hz) — ล็อคเป้าใหม่ไวขึ้นเท่าตัว
        -- ต้นทุนยังต่ำ: เช็คบนจอ+ระยะก่อน แล้วค่อย raycast เฉพาะตัวที่ชนะเท่านั้น
        if not TargetService.CurrentTarget then
                TargetService:AcquireTarget(camera, screenCenter, scaledFOV)
        end

        -- [v2.7] switch ease — เพิ่งล็อคใหม่/เพิ่งสลับเป้า ให้ช่วงสั้น ๆ ที่ไกล่เข้าหาเป้า
        -- (แทนการจุ๊บเข้าเป้าเดียวจบ = กระตุกตอนสลับ)
        if TargetService.CurrentTarget then
                if TargetService.CurrentTarget ~= prevAimKey then
                        switchEaseUntil = os.clock() + SWITCH_EASE_TIME
                end
                prevAimKey = TargetService.CurrentTarget
        else
                prevAimKey = nil
        end

        local targetPart = TargetService.TargetPart
        if TargetService.CurrentTarget and targetPart and targetPart.Parent then
                local shooterPos = camera.CFrame.Position

                -- [v2.4] Zoom-aware: ตอนซูม error มุมเดิมโตบนจอเป็นเท่าตัว
                -- → คูณความเร็วตามด้วย zoomScale ให้ความรู้สึกบนจอคงที่ทุกระดับซูม
                local zoomScale = zoomSmoothed -- [v2.6-PERF] ค่าเกลี่ยนุ่ม (EMA 80ms) จากด้านบน
                local baseSpeed = math.clamp(State.Smoothness * 120 * zoomScale, 6, 440) -- [v2.7] เพดานยกขึ้น

                -- [v2.4 FIX] τ = 1/k ส่งเข้าไปในตัว solve แทนการบวกที่จุดเล็ง
                -- (v2.2 บวก lead 3-4 stud บนจุดที่ projection ไกล 10,000 stud = แทบไม่เปลี่ยนมุม)
                local leadTau = State.LagComp and math.min(1 / baseSpeed, 0.15) or 0
                local targetPos = getPredictedPosition(targetPart, shooterPos, deltaTime, leadTau, zoomScale)

                -- [BUG 6 FIX ฝั่งนี้ด้วย] กัน .Unit บนเวกเตอร์ยาว 0
                local desiredDirection = safeUnit(targetPos - shooterPos)
                if desiredDirection then
                        -- [v2.2/v2.4] Catch-Up Boost — threshold หดตามซูม
                        -- (err 2° ตอนซูม 4x เห็นเท่า err 8° ปกติ → ให้ boost ที่ระดับเดียวกัน)
                        local dot = math.clamp(camera.CFrame.LookVector:Dot(desiredDirection), -1, 1)
                        local errDeg = math.deg(math.acos(dot))
                        -- [v2.6] snap แบบไล่ระดับ — เดิม if ตัดสิน binary (alpha เด้ง 0.6→1.0 ทันที
                        -- ตอน error แกว่งรอบ threshold = กระตุก) → [v2.7] ผสม snapBlend^1.5 แรมไวขึ้น
                        local snapAngle = State.SnapAngle or 20
                        local errScaled = errDeg * zoomScale
                        local boostC = State.TrackBoost or 1.5
                        local boost = 1 + math.min(errScaled / 10, 2) * boostC
                        local effSpeed = math.min(baseSpeed * boost, 560) -- [v2.7] เพดานยกขึ้น — ล็อคจบเร็วขึ้น
                        -- [v2.6-PERF] hitch guard — เฟรมติดขัด (dt 0.1-0.5s) ปกติ alpha≈1 กล้องเทเลพอร์ท
                        -- หาเป้าทีเดียว = กระตุกหลังแลคสไปค์ → จำกัด dt ของ smoothing ที่ 1/30s
                        -- (deltaTime เต็มยังส่งให้ prediction/slew และตัววัดสะบัดจอตามเดิม)
                        local sdt = math.min(deltaTime, 1 / 30)
                        local normalAlpha = 1 - math.exp(-effSpeed * sdt)
                        local alpha = normalAlpha
                        if snapAngle > 0 then
                                -- [v2.7] แรมไวขึ้น: เริ่ม 0.35× ถึงชุดเต็มที่ 0.85× ของ SnapAngle
                                -- (เดิม 0.5→1.0 ยกกำลัง 2 = ช่วง 10-20° ยังไต่ช้า)
                                local snapBlend = math.clamp((errScaled - snapAngle * 0.35) / (snapAngle * 0.5), 0, 1)
                                alpha = normalAlpha + (1 - normalAlpha) * snapBlend * math.sqrt(snapBlend)
                        end
                        -- [v2.7] ล็อคใหม่/สลับเป้า: ไกล่เข้าเป้า ~100ms — ไวแต่ไม่เทเลพอร์ท
                        if os.clock() < switchEaseUntil and errScaled > SWITCH_EASE_MIN_ERR then
                                alpha = math.min(alpha, 1 - math.exp(-SWITCH_EASE_SPEED * sdt))
                        end

                        -- [v2.7] Free Steer — ผู้เล่นลากกล้องหนีเป้า (มือเร็วเกินเกณฑ์ + คลาดเพิ่มขึ้น)
                        -- = ผ่อนแรงดึงตามมือ ไม่ต่อสู้ (ไม่เหนียว/ไม่กระตุก) หยุดมือ → แรงเต็มใน ~0.15s
                        -- ลากหนีค้างเกิน STEER_HOLD = ตั้งใจสลับเป้า → ปล่อยล็อคเหมือนสะบัด
                        local steering = State.FreeSteer and userDps > STEER_DPS
                                and prevErrDeg ~= nil and errDeg > prevErrDeg + 0.05
                        if steering then
                                if not steerHoldStart then steerHoldStart = os.clock() end
                                if State.DragSwitch and os.clock() - steerHoldStart >= STEER_HOLD then
                                        switchAwayKey = TargetService.CurrentTarget
                                        switchCooldownUntil = os.clock() + SWITCH_COOLDOWN
                                        TargetService:ReleaseTarget()
                                        flickUntil = os.clock() + FLICK_HOLD
                                        prevAimKey = nil
                                        triggerReset() -- [v2.8] ปล่อยล็อคแบบลากค้าง = หยุดยิงด้วย
                                        return
                                end
                        else
                                steerHoldStart = nil
                        end
                        local infTarget = steering and STEER_MIN_INFLUENCE or 1
                        steerInfluence += (infTarget - steerInfluence) * (1 - math.exp(-deltaTime / STEER_TAU))

                        -- [v2.9] ล็อคช่วงค่าก่อนผสมทิศ — ตัวเลขพังหลุดมาได้ก็ไม่ผสมลงกล้อง
                        alpha = math.clamp(alpha, 0, 1)
                        steerInfluence = math.clamp(steerInfluence, 0, 1)
                        local smoothDirection = safeUnit(camera.CFrame.LookVector:Lerp(desiredDirection, alpha * steerInfluence))
                        if smoothDirection then
                                -- [v2.9] เขียนกล้องผ่าน pcall — CFrame.lookAt โยน error (ทิศ collinear กับ up ฯลฯ)
                                -- = ข้ามเฟรมนั้นไป ไม่พังทั้ง render callback
                                local ok, newCFrame = pcall(CFrame.lookAt, shooterPos, shooterPos + smoothDirection)
                                if ok and newCFrame then
                                        camera.CFrame = newCFrame
                                        lastWriteLook = smoothDirection -- [v2.7] baseline วัดการหมุนของผู้เล่น (ฐาน b)
                                end
                        end
                        prevErrDeg = errDeg
                end
        end

        -- [v2.8] Trigger Bot — วัดท้ายเฟรม: ใช้ทิศกล้อง "หลัง" จากที่ aimbot ดันจุดเล็งแล้ว
        -- [v2.9] aimBusy = กล้องกำลัง snap/ไกล่ → triggerbot รอจุดเล็งนิ่งก่อนค่อยกด
        local aimBusy = os.clock() < flickUntil or os.clock() < switchEaseUntil
        runTriggerBot(camera, aimBusy)
end))
