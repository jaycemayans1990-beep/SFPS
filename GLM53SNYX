local function createSlider(text, min, max, default, step, callback)
        currentLayoutOrder += 1
        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 0, 48)
        frame.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
        frame.LayoutOrder = currentLayoutOrder
        frame.Parent = ScrollFrame

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 6)
        corner.Parent = frame

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(0.6, 0, 0, 20)
        label.Position = UDim2.new(0.04, 0, 0, 3)
        label.BackgroundTransparency = 1
        label.Text = text
        label.TextColor3 = Color3.fromRGB(220, 220, 220)
        label.Font = Enum.Font.SourceSans
        label.TextSize = 11
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Parent = frame

        local valLabel = Instance.new("TextLabel")
        valLabel.Size = UDim2.new(0.3, 0, 0, 20)
        valLabel.Position = UDim2.new(0.65, 0, 0, 3)
        valLabel.BackgroundTransparency = 1
        valLabel.Text = tostring(default)
        valLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
        valLabel.Font = Enum.Font.SourceSansBold
        valLabel.TextSize = 11
        valLabel.TextXAlignment = Enum.TextXAlignment.Right
        valLabel.Parent = frame

        local sliderBar = Instance.new("TextButton")
        sliderBar.Size = UDim2.new(0.92, 0, 0, 6)
        sliderBar.Position = UDim2.new(0.04, 0, 0, 30)
        sliderBar.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        sliderBar.Text = ""
        sliderBar.AutoButtonColor = false
        sliderBar.Parent = frame

        local barCorner = Instance.new("UICorner")
        barCorner.CornerRadius = UDim.new(0, 3)
        barCorner.Parent = sliderBar

        local sliderFill = Instance.new("Frame")
        local initialRatio = math.clamp((default - min) / (max - min), 0, 1)
        sliderFill.Size = UDim2.new(initialRatio, 0, 1, 0)
        sliderFill.BackgroundColor3 = Color3.fromRGB(180, 0, 255)
        sliderFill.BorderSizePixel = 0
        sliderFill.Parent = sliderBar

        local fillCorner = Instance.new("UICorner")
        fillCorner.CornerRadius = UDim.new(0, 3)
        fillCorner.Parent = sliderFill

        local dragging = false
        sliderBar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true

                        -- [BUG 1 FIX] snap แล้วเก็บ float noise ทิ้ง
                        -- เดิม: math.floor(x/step+0.5)*step ได้ 0.35000000000000003 โชว์บน label
                        local function update(inp)
                                local ratio = math.clamp(
                                        (inp.Position.X - sliderBar.AbsolutePosition.X)
                                        / math.max(sliderBar.AbsoluteSize.X, 1), 0, 1)
                                local n = math.floor((min + ratio * (max - min)) / step + 0.5)
                                local stepped = math.floor(n * step * 1e6 + 0.5) / 1e6
                                stepped = math.clamp(stepped, min, max)
                                sliderFill.Size = UDim2.new((stepped - min) / (max - min), 0, 1, 0)
                                valLabel.Text = (step >= 1) and tostring(math.floor(stepped + 0.5)) or tostring(stepped)
                                callback(stepped)
                        end

                        update(input)
                        local moveConn, relConn
                        moveConn = UserInputService.InputChanged:Connect(function(moveInp)
                                if dragging and (moveInp.UserInputType == Enum.UserInputType.MouseMovement
                                        or moveInp.UserInputType == Enum.UserInputType.Touch) then
                                        update(moveInp)
                                end
                        end)
                        relConn = UserInputService.InputEnded:Connect(function(relInp)
                                if relInp.UserInputType == Enum.UserInputType.MouseButton1
                                        or relInp.UserInputType == Enum.UserInputType.Touch then
                                        dragging = false
                                        moveConn:Disconnect()
                                        relConn:Disconnect()
                                end
                        end)
                end
        end)
end

