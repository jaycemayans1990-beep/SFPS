-- 5. VISIBILITY SERVICE (Reuse RaycastParams)
-- ==========================================
local VisibilityService = {}
local RayParams = RaycastParams.new()
RayParams.FilterType = Enum.RaycastFilterType.Exclude
RayParams.IgnoreWater = true

local ScratchFilter = {}

function VisibilityService:CheckVisibility(targetCharacter, pierceCount, specificPart)
        local camera = getCamera()
        if not (camera and targetCharacter) then return false end

        local targetPart = specificPart
        if not (targetPart and targetPart.Parent) then
                targetPart = targetCharacter:FindFirstChild("Head")
                        or targetCharacter:FindFirstChild("HumanoidRootPart")
        end
        if not targetPart then return false end

        local origin = camera.CFrame.Position
        local targetPos = targetPart.Position
        local direction = targetPos - origin

        if direction.Magnitude < 0.05 then return true end

        local maxPierces = pierceCount or 1
        local currentOrigin = origin
        local currentDirection = direction

        table.clear(ScratchFilter)
        local n = 0
        local myChar = LocalPlayer and LocalPlayer.Character
        if myChar then
                n += 1
                ScratchFilter[n] = myChar
        end

        for i = 1, maxPierces do
                RayParams.FilterDescendantsInstances = ScratchFilter
                local result = Workspace:Raycast(currentOrigin, currentDirection, RayParams)

                if not result then return true end

                local hitPart = result.Instance
                if hitPart:IsDescendantOf(targetCharacter) then return true end

                if i < maxPierces and (hitPart.Transparency > 0.8 or not hitPart.CanCollide) then
                        n += 1
                        ScratchFilter[n] = hitPart
                        local seg = targetPos - result.Position
                        local segUnit = safeUnit(seg)
                        if not segUnit then return true end
                        currentOrigin = result.Position + segUnit * 0.05
                        currentDirection = seg
                else
                        return false
                end
        end
        return false
end

local PlayerCache = setmetatable({}, { __mode = "k" })

local function getComponents(player)
        local char = player.Character
        if not char then
                PlayerCache[player] = nil
                return nil
        end

        local entry = PlayerCache[player]
        if not entry or entry.Character ~= char then
                entry = {
                        Character = char,
                        Humanoid = char:FindFirstChildOfClass("Humanoid"),
                        Root = char:FindFirstChild("HumanoidRootPart")
                }
                PlayerCache[player] = entry
        end

        if not entry.Humanoid then
                entry.Humanoid = char:FindFirstChildOfClass("Humanoid")
        end
        return entry
end

local function isValidEnemy(player)
        if not player or player == LocalPlayer then return false end
        local entry = getComponents(player)
        if not entry then return false end

        local humanoid, root = entry.Humanoid, entry.Root
        if not humanoid or humanoid.Health <= 0 then return false end
        if not root or root.Parent ~= entry.Character then return false end
        if entry.Character:FindFirstChildOfClass("ForceField") then return false end
        if State.TeamCheck and player.Team and LocalPlayer.Team
                and player.Team == LocalPlayer.Team then
                return false
        end
        return true
end

CleanupManager:AddConn("PlayerRemovingCaches", Players.PlayerRemoving:Connect(function(player)
        PlayerCache[player] = nil
end))
