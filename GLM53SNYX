local FOVCircle = Drawing.new("Circle")
FOVCircle.Thickness = 1.5
FOVCircle.Color = Color3.fromRGB(255, 255, 255)
FOVCircle.Filled = false
FOVCircle.Transparency = 0.7
FOVCircle.Visible = false
CleanupManager:AddDrawing("FOVCircle", FOVCircle)

local function hasActiveWeapon()
        local character = LocalPlayer and LocalPlayer.Character
        return character ~= nil and character:FindFirstChildOfClass("Tool") ~= nil
end

local frameTick = 0

CleanupManager:AddConn("RenderStep", RunService.RenderStepped:Connect(function(deltaTime)
        local camera = getCamera()
        if not camera then return end

        local vp = camera.ViewportSize
        local screenCenter = Vector2.new(vp.X * 0.5, vp.Y * 0.5)
        local scaledFOV = State.FOV * (vp.Y / 1080)

        if State.ShowFOV then
                FOVCircle.Position = screenCenter
                FOVCircle.Radius = scaledFOV
                FOVCircle.Visible = true
        elseif FOVCircle.Visible then
                FOVCircle.Visible = false
        end

        if not State.Aimbot or not hasActiveWeapon() then
                if TargetService.CurrentTarget then TargetService:ReleaseTarget() end
                return
        end

        if TargetService.CurrentTarget then
                if not TargetService:KeepTarget(camera, screenCenter, scaledFOV) then
                        TargetService:ReleaseTarget()
                end
        end

        if not TargetService.CurrentTarget then
                frameTick += 1
                if frameTick % 2 == 0 then
                        TargetService:AcquireTarget(camera, screenCenter, scaledFOV)
                end
        end

        local targetPart = TargetService.TargetPart
        if TargetService.CurrentTarget and targetPart and targetPart.Parent then
                local shooterPos = camera.CFrame.Position
                local targetPos = getPredictedPosition(targetPart, shooterPos, deltaTime)

                local baseSpeed = math.clamp(State.Smoothness * 120, 6, 300)

                if State.LagComp then
                        local tau = math.min(1 / baseSpeed, 0.15)
                        local kinPart = getKinematicPart(targetPart)
                        local vel = kinPart and kinPart.AssemblyLinearVelocity
                        if vel and vel.Magnitude > 1e-3 then
                                targetPos += vel * tau
                        end
                end

                local desiredDirection = safeUnit(targetPos - shooterPos)
                if desiredDirection then
                        local dot = math.clamp(camera.CFrame.LookVector:Dot(desiredDirection), -1, 1)
                        local errDeg = math.deg(math.acos(dot))
                        local boostC = State.TrackBoost or 1.5
                        local boost = 1 + math.min(errDeg / 10, 2) * boostC
                        local effSpeed = math.min(baseSpeed * boost, 360)

                        local alpha = 1 - math.exp(-effSpeed * deltaTime)
                        local smoothDirection = safeUnit(camera.CFrame.LookVector:Lerp(desiredDirection, alpha))
                        if smoothDirection then
                                camera.CFrame = CFrame.lookAt(shooterPos, shooterPos + smoothDirection)
                        end
                end
        end
end))

