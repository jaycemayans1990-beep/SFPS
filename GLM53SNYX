local function backendOrder(touch, choice)
        if choice ~= "Press" and choice ~= "VirtualUser" and choice ~= "VIM" then
                choice = "Auto"
        end
        if choice == "Press" then return { "Press" } end
        if choice == "VirtualUser" then return { "VirtualUser" } end
        if choice == "VIM" then return { "VIM" } end
        if touch then return { "VirtualUser", "Press" } end
        return { "Press", "VIM", "VirtualUser" }
end

local function makeBackend(name)
        if name == "Press" then
                if type(mouse1press) ~= "function" or type(mouse1release) ~= "function" then
                        return nil
                end
                return mouse1press, mouse1release, "mouse1press"
        end
        if name == "VIM" then
                local okVim, vim = pcall(function() return game:GetService("VirtualInputManager") end)
                if not okVim or not vim then return nil end
                local function sendMouseButton(down)
                        local cam = getCamera()
                        if not cam then return end
                        local vp = cam.ViewportSize
                        vim:SendMouseButtonEvent(vp.X * 0.5, vp.Y * 0.5, 0, down, game, 1)
                end
                return function() sendMouseButton(true) end, function() sendMouseButton(false) end,
                        "VirtualInputManager"
        end
        if name == "VirtualUser" then
                local okVu, vu = pcall(function() return game:GetService("VirtualUser") end)
                if not okVu or not vu then return nil end
                return function()
                                vu:CaptureController()
                                local cam = getCamera()
                                vu:Button1Down(Vector2.new(), cam and cam.CFrame or CFrame.new())
                        end, function()
                                vu:CaptureController()
                                local cam = getCamera()
                                vu:Button1Up(Vector2.new(), cam and cam.CFrame or CFrame.new())
                        end, "VirtualUser"
        end
        return nil
end

local firePress, fireRelease, fireName = nil, nil, nil
local triggerBackendQueue = {}

local function pickNextBackend(reason)
        firePress, fireRelease = nil, nil
        while #triggerBackendQueue > 0 do
                local name = table.remove(triggerBackendQueue, 1)
                local press, release, displayName = makeBackend(name)
                if press then
                        firePress, fireRelease, fireName = press, release, displayName
                        log("INFO", "Trigger Bot backend: " .. displayName
                                .. (reason and (" — " .. reason) or ""))
                        return true
                end
        end
        fireName = nil
        return false
end

